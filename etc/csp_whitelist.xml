<?xml version="1.0"?>
<!-- LiveChat domains. Verify in CSP report-only mode before enforcing on checkout. -->
<csp_whitelist xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Csp:etc/csp_whitelist.xsd">
    <policies>
        <policy id="script-src">
            <values>
                <value id="zero1_livechat_cdn" type="host">cdn.livechatinc.com</value>
                <value id="zero1_livechat_secure" type="host">secure.livechatinc.com</value>
            </values>
        </policy>
        <policy id="connect-src">
            <values>
                <value id="zero1_livechat_all" type="host">*.livechatinc.com</value>
                <value id="zero1_livechat_wss" type="host">wss://*.livechatinc.com</value>
                <value id="zero1_livechat_text" type="host">*.text.com</value>
            </values>
        </policy>
        <policy id="frame-src">
            <values>
                <value id="zero1_livechat_frame" type="host">*.livechatinc.com</value>
                <value id="zero1_livechat_text_frame" type="host">*.text.com</value>
            </values>
        </policy>
        <policy id="img-src">
            <values>
                <value id="zero1_livechat_img" type="host">*.livechatinc.com</value>
                <value id="zero1_livechat_files_img" type="host">*.livechat-files.com</value>
            </values>
        </policy>
        <policy id="style-src">
            <values>
                <value id="zero1_livechat_style" type="host">cdn.livechatinc.com</value>
            </values>
        </policy>
        <policy id="font-src">
            <values>
                <value id="zero1_livechat_font" type="host">cdn.livechatinc.com</value>
            </values>
        </policy>
    </policies>
</csp_whitelist>
