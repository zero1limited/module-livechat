{
    "name": "zero1/module-livechat",
    "description": "LiveChat integration for Magento 2 / Hyvä: deferred widget embed plus product-tab chat drafts",
    "require": {
        "php": ">=7.4",
        "magento/framework": "*",
        "magento/module-catalog": "*",
        "magento/module-config": "*",
        "magento/module-store": "*"
    },
    "suggest": {
        "magento/module-csp": "LiveChat domains are whitelisted via etc/csp_whitelist.xml"
    },
    "type": "magento2-module",
    "license": [
        "proprietary"
    ],
    "keywords": [
        "Magento Open Source",
        "Adobe Commerce",
        "Hyva",
        "LiveChat",
        "ZERO-1"
    ],
    "homepage": "https://www.zero1.co.uk",
    "support": {
        "email": "support@zero1.co.uk"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Zero1\\Livechat\\": ""
        }
    }
}
