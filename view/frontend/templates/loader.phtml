<?php
/**
 * Outputs the "Web Widget HTML Code" pasted in admin, wrapped so that:
 *  - group / chat_between_groups / product params are set on window.__lc first
 *  - "first interaction" loading works by setting __lc.asyncInit (honoured by the
 *    official snippet) and calling LiveChatWidget.init() later
 *  - nothing loads twice if LiveChat is already on the page (GTM / theme)
 *  - every inline script goes through SecureHtmlRenderer for CSP
 *
 * @var \Magento\Framework\View\Element\Template $block
 * @var \Magento\Framework\View\Helper\SecureHtmlRenderer $secureRenderer
 * @var \Zero1\Livechat\ViewModel\Livechat $viewModel
 */
$viewModel = $block->getData('view_model');
if (!$viewModel->isEmbedEnabled()) {
    return;
}
$parts = $viewModel->getWidgetParts();
if ($parts['scripts'] === []) {
    return;
}
$config = $viewModel->getEmbedJson();

$prelude = <<<JS
(function (w) {
    var cfg = {$config};
    var existing = !!w.LiveChatWidget;
    w.__zero1Lc = { cfg: cfg, existing: existing };
    w.__lc = w.__lc || {};
    Object.keys(cfg.lc).forEach(function (k) { w.__lc[k] = cfg.lc[k]; });
    // asyncInit stops the vendor snippet calling init() itself
    if (existing || cfg.onInteraction) { w.__lc.asyncInit = true; }
})(window);
JS;

$postlude = <<<JS
(function (w, d) {
    var s = w.__zero1Lc;
    if (!s || s.existing || !w.LiveChatWidget) { return; }

    function trackingLoaded() {
        return !!w.__lc_inited || !!d.querySelector('script[src*="livechatinc.com/tracking.js"]');
    }

    var started = false;
    function start() {
        if (started) { return; }
        started = true;
        if (!trackingLoaded() && typeof w.LiveChatWidget.init === 'function') {
            w.LiveChatWidget.init();
        }
    }
    w.zero1LiveChatLoad = start;

    if (!s.cfg.onInteraction) { return; } // vendor snippet has already initialised

    var events = ['pointerdown', 'keydown', 'touchstart', 'scroll', 'mousemove'];
    function onFirst() {
        events.forEach(function (e) { w.removeEventListener(e, onFirst, {passive: true}); });
        start();
    }
    events.forEach(function (e) { w.addEventListener(e, onFirst, {passive: true, once: true}); });
})(window, document);
JS;
?>
<?= /* @noEscape */ $secureRenderer->renderTag('script', [], $prelude, false) ?>
<?php foreach ($parts['scripts'] as $script): ?>
<?= /* @noEscape */ $secureRenderer->renderTag(
    'script',
    $script['attributes'],
    $script['content'],
    false
) ?>
<?php endforeach; ?>
<?= /* @noEscape */ $secureRenderer->renderTag('script', [], $postlude, false) ?>
<?php if ($parts['noscript'] !== ''): ?>
<?= /* @noEscape */ $parts['noscript'] ?>
<?php endif; ?>
